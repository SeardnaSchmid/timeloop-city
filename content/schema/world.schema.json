{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldFile",
  "description": "A world definition: population, goods, businesses and behaviour tuning.\nAll numbers are integers; needs use a 0-1000 scale.",
  "type": "object",
  "properties": {
    "action": {
      "description": "Decision rules per action: eat, sleep, work, overtime, wander. An\naction without a rule never happens; wander is the fallback.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ActionSection"
      }
    },
    "business": {
      "description": "Businesses in ID order. Order matters: ties go to the lower ID.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/BusinessSection"
      }
    },
    "founding": {
      "description": "Agents founding firms. Without this section only the businesses\nabove exist.",
      "anyOf": [
        {
          "$ref": "#/$defs/FoundingSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "goods": {
      "$ref": "#/$defs/GoodsSection"
    },
    "house": {
      "description": "Houses in ID order. Each rents out beds by the day.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HouseSection"
      }
    },
    "housing": {
      "$ref": "#/$defs/HousingSection"
    },
    "life": {
      "description": "Ageing, education, retirement, death and new people. Without it\nnobody ages.",
      "anyOf": [
        {
          "$ref": "#/$defs/LifeSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "map": {
      "$ref": "#/$defs/MapSection"
    },
    "market": {
      "$ref": "#/$defs/MarketSection"
    },
    "meal": {
      "$ref": "#/$defs/MealSection"
    },
    "needs": {
      "$ref": "#/$defs/NeedsSection"
    },
    "population": {
      "description": "Agent groups; agents are split over them in ID order, by weight.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PopulationSection"
      }
    },
    "traits": {
      "$ref": "#/$defs/TraitsSection"
    },
    "wander": {
      "$ref": "#/$defs/WanderSection"
    },
    "work": {
      "$ref": "#/$defs/WorkSection"
    },
    "world": {
      "$ref": "#/$defs/WorldSection"
    }
  },
  "additionalProperties": false,
  "required": [
    "world",
    "goods",
    "business",
    "market",
    "map",
    "house",
    "housing",
    "traits",
    "population",
    "needs",
    "meal",
    "work",
    "wander",
    "action"
  ],
  "$defs": {
    "ActionSection": {
      "description": "Formulas are integer expressions over the decision variables:\n`need.hunger`, `need.fatigue`, `need.safety` (0-1000), `money`, `wage`,\n`food_price`, `can_eat`, `employed`, `hour`, `night`, `work_time`,\n`overtime_time` (0 or 1) and `trait.<name>`. Operators: `+ - * / %`,\ncomparisons, `&& || !`, `min max clamp if`.",
      "type": "object",
      "properties": {
        "score": {
          "description": "The allowed action with the highest score is chosen.",
          "type": "string"
        },
        "when": {
          "description": "Extra precondition; the action is allowed when this is > 0.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "score"
      ]
    },
    "BusinessSection": {
      "type": "object",
      "properties": {
        "cash": {
          "description": "Starting cash.",
          "type": "integer",
          "format": "int64"
        },
        "input": {
          "description": "Input consumed per unit of output. Omit for raw producers (fields, mines).",
          "anyOf": [
            {
              "$ref": "#/$defs/InputSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_target": {
          "description": "Input stock the business restocks to every morning.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "output": {
          "description": "Good this business produces and sells.",
          "type": "string"
        },
        "output_milli_per_worker_hour": {
          "description": "Output per worker-hour in thousandths of a unit (1500 = 1.5 units).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_target": {
          "description": "Output stock the business aims for. Below it the price rises, above twice it falls.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "price": {
          "description": "Starting price per unit of output.",
          "type": "integer",
          "format": "int64"
        },
        "slots": {
          "description": "Maximum number of workers.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stock": {
          "description": "Output units in stock at the start.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "wage": {
          "description": "Starting wage per worker-hour.",
          "type": "integer",
          "format": "int64"
        },
        "x": {
          "description": "Parcel the business stands on.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "x",
        "y",
        "output",
        "output_milli_per_worker_hour",
        "slots",
        "cash",
        "price",
        "wage",
        "output_target"
      ]
    },
    "ComfortSection": {
      "description": "Above safety: savings beyond the safety reserve are partly spent on\ncomforts each day. The town provides them; the money returns as welfare.",
      "type": "object",
      "properties": {
        "spend_permille": {
          "description": "Thousandths of the savings above the reserve spent per day.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "spend_permille"
      ]
    },
    "FatigueSection": {
      "type": "object",
      "properties": {
        "max_sleep_minutes": {
          "description": "Longest sleep in minutes; agents get up then even if not rested.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "per_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "recovery_per_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "per_hour",
        "recovery_per_hour",
        "max_sleep_minutes"
      ]
    },
    "FoundingSection": {
      "description": "Once a day every agent without a firm scores founding one for each good\n(the first business above making it is the blueprint); the best allowed\nfounding happens, at most one a day. The founder pays `capital` into the\nfirm and runs it as CEO; the firm's surplus goes to the founder.\nFormulas see the action variables plus `market.price` and `market.cost`\n(lowest price and unit cost of the good's makers), `market.shortage`\n(0-1000, how often it ran short lately), `market.firms` (its makers) and\n`firm.capital`. `close` is read daily for every CEO with `firm.cash`,\n`firm.broke_days` (days in a row without a day's payroll) and `firm.age_days`.",
      "type": "object",
      "properties": {
        "capital": {
          "type": "integer",
          "format": "int64"
        },
        "close": {
          "description": "The firm closes when this is > 0.",
          "type": "string"
        },
        "max_firms": {
          "description": "Open founded firms at most.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profit_tax_percent": {
          "description": "Percent of a firm's surplus the town takes for welfare; the owner gets the rest.",
          "type": "integer",
          "format": "int64"
        },
        "score": {
          "type": "string"
        },
        "when": {
          "description": "Founding is an option when this is > 0.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capital",
        "profit_tax_percent",
        "max_firms",
        "score",
        "close"
      ]
    },
    "GoodsSection": {
      "type": "object",
      "properties": {
        "food": {
          "description": "The good agents buy and eat.",
          "type": "string"
        },
        "names": {
          "description": "All goods, by name.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "names",
        "food"
      ]
    },
    "HouseSection": {
      "type": "object",
      "properties": {
        "beds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "rent": {
          "description": "Starting rent per bed and day.",
          "type": "integer",
          "format": "int64"
        },
        "x": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "x",
        "y",
        "beds",
        "rent"
      ]
    },
    "HousingSection": {
      "description": "Once a day every agent scores each house it could move into (or its own)\nagainst staying homeless and takes the best. Formulas see the action\nvariables plus `house.rent`, `house.distance` (to work, or the town centre\nwhen unemployed) and `house.current` (1 for its own home).",
      "type": "object",
      "properties": {
        "homeless_recovery_percent": {
          "description": "Sleep recovery without a home, in percent of the normal rate.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "homeless_score": {
          "description": "Score of having no home.",
          "type": "string"
        },
        "rent_min": {
          "type": "integer",
          "format": "int64"
        },
        "rent_step": {
          "description": "Daily rent change: up when full and someone was turned away, down when beds stay free.",
          "type": "integer",
          "format": "int64"
        },
        "score": {
          "type": "string"
        },
        "when": {
          "description": "The house is an option when this is > 0.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rent_step",
        "rent_min",
        "homeless_recovery_percent",
        "score",
        "homeless_score"
      ]
    },
    "HungerSection": {
      "type": "object",
      "properties": {
        "critical": {
          "description": "Interrupts the current action to go eat.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "per_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "per_hour",
        "critical"
      ]
    },
    "InputSection": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "good": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "good",
        "amount"
      ]
    },
    "LifeSection": {
      "description": "Ages are in years. The number of agents stays fixed: whoever dies is\nreplaced the same day by a descendant of a living agent or a newcomer,\nentering at `entry_age` with no money. Money and firm go to the children\n(the firm to one, who runs it), without children to the town.",
      "type": "object",
      "properties": {
        "birth_percent": {
          "description": "Chance in percent that a free place goes to a child of an agent aged\n`parent_age` rather than to a newcomer.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "education_end_age": {
          "description": "No job before this age.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "entry_age": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inheritance_tax_percent": {
          "description": "Percent of an estate the town takes for welfare before the children share the rest.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lifespan": {
          "description": "Rolled once per person, evenly in this range.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "parent_age": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "pension_percent": {
          "description": "Percent of every wage paid into the pension fund, shared out daily\nto everyone in education or retired.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "retirement_age": {
          "description": "No job from this age on.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start_age": {
          "description": "Ages of the first inhabitants, spread evenly.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "start_age",
        "entry_age",
        "education_end_age",
        "retirement_age",
        "lifespan",
        "birth_percent",
        "parent_age",
        "pension_percent",
        "inheritance_tax_percent"
      ]
    },
    "MapSection": {
      "type": "object",
      "properties": {
        "height": {
          "description": "Parcels down; y runs 0..height.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "land_price_base": {
          "description": "Land price of a parcel far from any house.",
          "type": "integer",
          "format": "int64"
        },
        "land_price_radius": {
          "description": "Houses closer than this raise the land price around them by their rent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "travel_minutes_per_parcel": {
          "description": "Walking time per parcel (Manhattan distance).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "width": {
          "description": "Parcels across; x runs 0..width.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "travel_minutes_per_parcel",
        "land_price_base",
        "land_price_radius"
      ]
    },
    "MarketSection": {
      "type": "object",
      "properties": {
        "price_min": {
          "type": "integer",
          "format": "int64"
        },
        "price_step": {
          "description": "Daily price change when stock is off target.",
          "type": "integer",
          "format": "int64"
        },
        "reserve_days": {
          "description": "Days of full payroll kept in cash. Below it wages fall, above twice it they rise.",
          "type": "integer",
          "format": "int64"
        },
        "wage_min": {
          "type": "integer",
          "format": "int64"
        },
        "wage_step": {
          "description": "Daily wage change when cash is off target.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "price_step",
        "price_min",
        "wage_step",
        "wage_min",
        "reserve_days"
      ]
    },
    "MealSection": {
      "type": "object",
      "properties": {
        "minutes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "relief": {
          "description": "Hunger removed by one meal.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "relief",
        "minutes"
      ]
    },
    "NeedsSection": {
      "type": "object",
      "properties": {
        "comfort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComfortSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "fatigue": {
          "$ref": "#/$defs/FatigueSection"
        },
        "hunger": {
          "$ref": "#/$defs/HungerSection"
        },
        "safety": {
          "$ref": "#/$defs/SafetySection"
        }
      },
      "additionalProperties": false,
      "required": [
        "hunger",
        "fatigue",
        "safety"
      ]
    },
    "PopulationSection": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "traits": {
          "description": "`[min, max]` per trait; agents roll evenly in between. Missing traits are 500.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "maxItems": 2,
            "minItems": 2
          },
          "default": {}
        },
        "weight": {
          "description": "Share of the agents, relative to the other populations.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "weight"
      ]
    },
    "SafetySection": {
      "description": "Safety is 1000 without savings and 0 once savings cover the reserve.",
      "type": "object",
      "properties": {
        "meals_per_day": {
          "type": "integer",
          "format": "int64"
        },
        "reserve_days": {
          "description": "Days of meals the reserve covers.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "reserve_days",
        "meals_per_day"
      ]
    },
    "TraitsSection": {
      "type": "object",
      "properties": {
        "names": {
          "description": "Character traits (0-1000). Formulas read them as `trait.<name>`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "names"
      ]
    },
    "WanderSection": {
      "type": "object",
      "properties": {
        "max_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min_minutes",
        "max_minutes"
      ]
    },
    "WorkSection": {
      "type": "object",
      "properties": {
        "block_minutes": {
          "description": "Work happens in blocks of at most this long; agents decide again after each.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "end_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "overtime_end_hour": {
          "description": "Overtime runs from end_hour to here.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start_hour",
        "end_hour",
        "overtime_end_hour",
        "block_minutes"
      ]
    },
    "WorldSection": {
      "type": "object",
      "properties": {
        "agents": {
          "description": "Number of agents.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start_money": {
          "description": "Money each agent starts with.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "agents",
        "start_money"
      ]
    }
  }
}
